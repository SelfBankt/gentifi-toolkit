[Unit]
Description=Gentifi host: hosted business connectors
After=network-online.target
Wants=network-online.target

[Service]
User=gentifi
Group=gentifi
WorkingDirectory=/srv/gentifi/toolkit
# The owner bot on this machine (gentifi-profile's gentifi-bot service): orders for owners
# linked in Telegram go to them there. Harmless if the bot isn't installed.
Environment=GENTIFI_BOT_URL=http://127.0.0.1:8765
Environment=GENTIFI_BOT_SECRET_FILE=/var/lib/gentifi-bot/handoff-secret
# Businesses the bot is still onboarding: hidden here until their owner goes live
Environment=GENTIFI_ONBOARDING_FILE=/var/lib/gentifi-bot/onboarding.json
Environment=GENTIFI_STOCK_FILE=/var/lib/gentifi-bot/stock.json
ExecStart=/usr/bin/node bin/gentifi.js host --dir /srv/gentifi/businesses --base-url https://mcp.gentifi.com --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/gentifi/businesses

[Install]
WantedBy=multi-user.target
